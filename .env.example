# Copy to .env for local development. Never commit the real value.
#
# Optional. Without it the chatbot still answers: /api/design returns 503 and the
# page falls back to the offline word-to-patch mapper, which needs no network.
#
# Production values go in hosting config, not here:
#   ChatGPT Sites — chatgpt.com/sites → More actions → Settings → environment values
#   Vercel        — Project → Settings → Environment Variables
OPENROUTER_API_KEY=

# Optional. Enables generated instrumental audio via the server-side MiniMax
# proxy. The browser receives only a short-lived audio URL, never this key.
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0-free
