:root {
  color-scheme: dark;
}

body {
  background:
    radial-gradient(1200px 600px at 20% -10%, #2a2114 0%, transparent 50%),
    #0b0a08;
}

.grain {
  pointer-events: none;
  position: fixed;
  inset: 0;
  opacity: 0.16;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
}

.rack-face {
  background:
    linear-gradient(180deg, #2a2620 0%, #161410 48%, #100e0b 100%);
  border: 1px solid #3b362c;
  box-shadow:
    inset 0 1px 0 #4a4438,
    0 30px 80px rgba(0, 0, 0, 0.45);
  border-radius: 22px;
  padding: 22px;
  position: relative;
}

.rack-face::before,
.rack-face::after {
  content: "";
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #8a8374, #2c291f);
  top: 14px;
}

.rack-face::before { left: 14px; }
.rack-face::after { right: 14px; }

.lcd {
  width: 100%;
  min-height: 148px;
  padding: 14px 16px;
  border: 0;
  border-radius: 10px;
  background:
    linear-gradient(180deg, #d8b45c 0%, #c79a3b 100%);
  color: #1b1408;
  box-shadow: inset 0 0 0 3px #8a6b24, inset 0 0 40px rgba(80, 50, 0, 0.25);
  font-weight: 600;
  letter-spacing: 0.06em;
  text-align: left;
}

.lcd:focus-visible {
  outline: 2px solid #9dff6a;
  outline-offset: 3px;
}

.power {
  width: 54px;
  height: 10px;
  border-radius: 99px;
  background: #2a261c;
  box-shadow: inset 0 0 6px #000;
}

.power.live {
  background: #9dff6a;
  box-shadow: 0 0 12px #9dff6a;
}

#agent-chip.live {
  color: #9dff6a;
}

.ghost-btn,
.mini,
.chip,
.agent-input {
  background: #16140f;
  border: 1px solid #3d382c;
  color: #ece4d4;
  border-radius: 999px;
  padding: 8px 14px;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mini { padding: 6px 10px; border-radius: 8px; }
.file { cursor: pointer; }

.generate {
  background: linear-gradient(180deg, #f0d27a, #c4922c);
  color: #1b1408;
  border: 0;
  border-radius: 999px;
  padding: 10px 22px;
  font-family: Tektur, sans-serif;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.generate.sm { padding: 8px 14px; }

.knob-wrap {
  display: grid;
  justify-items: center;
  gap: 6px;
  color: #b7ae9c;
  font-size: 10px;
  letter-spacing: 0.16em;
}

.dial {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background:
    conic-gradient(from 220deg, #2c281f, #6a624f, #2c281f);
  box-shadow: inset 0 0 0 4px #111, 0 4px 0 #0a0907;
  position: relative;
}

.dial.master { width: 58px; height: 58px; }

.dial::after {
  content: "";
  position: absolute;
  width: 2px;
  height: 16px;
  background: #e7c36a;
  left: 50%;
  top: 7px;
  transform: translateX(-50%) rotate(var(--rot)) ;
  transform-origin: 50% 15px;
}

.knob-wrap input[type="range"] {
  width: 54px;
  accent-color: #e7c36a;
}

.fx-row {
  margin-top: 18px;
  display: grid;
  grid-template-columns: 70px repeat(5, 1fr);
  align-items: end;
  gap: 8px;
  border-top: 1px solid #3a352b;
  padding-top: 14px;
}

.fx-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: #8f8776;
  padding-bottom: 18px;
}

.piano {
  position: relative;
  height: 128px;
  margin-top: 16px;
  background: #0e0c0a;
  border-radius: 10px;
  overflow: hidden;
}

.key {
  position: absolute;
  border: 0;
  bottom: 0;
}

.key.white {
  height: 100%;
  background: linear-gradient(#f4efe3, #c9c0ad);
  border-right: 1px solid #8c8473;
}

.key.black {
  height: 62%;
  top: 0;
  background: linear-gradient(#2a261f, #090807);
  z-index: 2;
  border-radius: 0 0 4px 4px;
}

.key.on-human.white { background: #e7c36a; }
.key.on-human.black { background: #c4922c; }
.key.on-agent.white { background: #9dff6a; }
.key.on-agent.black { background: #4d8a2e; }
.key.on-both.white {
  background: linear-gradient(90deg, #e7c36a 50%, #9dff6a 50%);
}
.key.on-both.black {
  background: linear-gradient(90deg, #c4922c 50%, #4d8a2e 50%);
}

.key.on-next.white {
  background: linear-gradient(#e8f7ff, #9ad8f2);
  box-shadow: inset 0 0 0 3px #5ec8ff, 0 0 18px rgba(94, 200, 255, 0.45);
  animation: next-breathe 1.1s ease-in-out infinite;
}

.key.on-next.black {
  background: #1a3340;
  box-shadow: inset 0 0 0 2px #5ec8ff, 0 0 12px #5ec8ff;
  animation: next-breathe 1.1s ease-in-out infinite;
}

.key-face {
  pointer-events: none;
  position: absolute;
  inset: 0;
}

.key-name {
  pointer-events: none;
  position: absolute;
  bottom: 6px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 8px;
  letter-spacing: 0.08em;
  color: #6a6254;
}

.key.black .key-name { color: #8f8776; bottom: 4px; }

.key-badge {
  pointer-events: none;
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  min-width: 16px;
  padding: 1px 5px;
  border-radius: 99px;
  background: #0b3a4d;
  color: #e8f7ff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  z-index: 3;
}

.key.black .key-badge { top: 6px; font-size: 9px; }

@keyframes next-breathe {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.12); }
}

.duet-strip {
  margin-top: 16px;
  display: grid;
  grid-template-columns: auto 1fr auto auto 1fr;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 10px;
  background: #0e0c0a;
  border: 1px solid #2c281f;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.duet-strip.together {
  border-color: #9dff6a;
  box-shadow: 0 0 0 1px rgba(157, 255, 106, 0.25);
}

.pill {
  padding: 3px 8px;
  border-radius: 99px;
  border: 1px solid #3d382c;
  color: #8f8776;
}

.pill.you.live {
  color: #1b1408;
  background: #e7c36a;
  border-color: #e7c36a;
}

.pill.agent.live {
  color: #0b0a08;
  background: #9dff6a;
  border-color: #9dff6a;
}

.duet-notes { color: #ece4d4; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.duet-mid { color: #8f8776; letter-spacing: 0.2em; }

.lesson-strip {
  margin-top: 16px;
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border-radius: 10px;
  background: #0e0c0a;
  border: 1px solid #2c281f;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.lesson-strip.teaching {
  border-color: #5ec8ff;
  box-shadow: 0 0 0 1px rgba(94, 200, 255, 0.28);
}

.pill.next.live {
  color: #041820;
  background: #5ec8ff;
  border-color: #5ec8ff;
}

.lesson-hits { color: #8f8776; white-space: nowrap; }

.take-line {
  margin-top: 12px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #8f8776;
}

.take-line span { color: #ece4d4; }

.chip.live {
  border-color: #9dff6a;
  color: #9dff6a;
}

.roll {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  height: 72px;
  margin-top: 14px;
  background: #0e0c0a;
  border-radius: 8px;
  overflow: hidden;
}

.roll-beat {
  position: relative;
  border-right: 1px solid #262218;
}

.roll-bar { background: rgba(231, 195, 106, 0.06); }

.roll-hit {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 99px;
  background: #e7c36a;
}

.agent-panel {
  background: #14120e;
  border: 1px solid #3b362c;
  border-radius: 22px;
  padding: 18px;
  min-height: 520px;
  display: flex;
  flex-direction: column;
}

.agent-log {
  margin-top: 14px;
  flex: 1;
  overflow: auto;
  max-height: 360px;
}

.bubble {
  margin-bottom: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  white-space: pre-wrap;
  font-size: 12px;
  line-height: 1.45;
}

.bubble span {
  display: block;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-bottom: 4px;
  color: #8f8776;
}

.bubble.user { background: #221e18; }
.bubble.agent { background: #1d1a12; border: 1px solid #3d3420; }

.agent-input {
  flex: 1;
  border-radius: 12px;
  text-transform: none;
  letter-spacing: 0;
}

.meter {
  background: #0a0907;
  border-radius: 4px;
}

.hidden { display: none !important; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
}

@media (max-width: 900px) {
  .fx-row { grid-template-columns: repeat(3, 1fr); }
  .fx-label { grid-column: 1 / -1; padding-bottom: 0; }
}
